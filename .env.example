# Ntfy
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=HEREISWORKNOTIFICATION
NTFY_TOKEN=
NTFY_PRIORITY=high
NTFY_TIMEOUT_MS=10000
NTFY_MAX_RETRIES=5
NTFY_RETRY_BASE_MS=1000
NTFY_RETRY_MAX_MS=30000

# Filtering (empty allowlist = forward nothing — safe default)
NOTIFICATION_ALLOWLIST=Microsoft Teams,Teams,Microsoft Teams classic,Zoho,Zoho Mail,Zoho Cliq,Zoho One,Google Chrome,Microsoft Edge,Outlook,Mail
NOTIFICATION_BLOCKLIST=
TITLE_BLOCK_KEYWORDS=update available
MESSAGE_BLOCK_KEYWORDS=
TITLE_ALLOW_KEYWORDS=
NOTIFICATION_DEDUP_SECONDS=10

# Offline queue
QUEUE_ENABLED=true
QUEUE_MAX_SIZE=500
QUEUE_MAX_AGE_HOURS=24
QUEUE_FLUSH_INTERVAL_MS=15000
QUEUE_PATH=./data/queue.jsonl

# Windows listener
LISTENER_POLL_MS=1000
LISTENER_PATH=
# Set SIMULATE=true to emit fake notifications without the C# listener
SIMULATE=false

# Heartbeat (default: off / log-only — does not spam your phone)
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_MS=300000
HEARTBEAT_MODE=log

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Startup task name (Task Scheduler)
SERVICE_TASK_NAME=NotificationBridge
